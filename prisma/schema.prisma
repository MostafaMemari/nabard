// Taekwondo Competitions - minimal MVP
// Flow: admin creates a competition -> coach registers students and uploads a
// card-to-card receipt -> admin confirms the receipt and approves/rejects each student.
//
// Belt, AgeCategory and WeightClass are the same models as the existing project schema.
//
// Prisma 7: the datasource has no url here. The CLI (migrate, studio, db commands)
// reads DIRECT_URL from prisma.config.ts, the runtime client connects through the
// Neon driver adapter with DATABASE_URL (see src/lib/prisma.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")
}

enum Role {
  ADMIN       @map("admin") // province admin (province is set on the user)
  COACH       @map("coach")
  SUPER_ADMIN @map("super_admin") // manages admins, counties and base data; has no province
}

enum Province {
  TEHRAN                     @map("tehran")
  ISFAHAN                    @map("isfahan")
  FARS                       @map("fars")
  RAZAVI_KHORASAN            @map("razavi_khorasan")
  KHUZESTAN                  @map("khuzestan")
  EAST_AZERBAIJAN            @map("east_azerbaijan")
  WEST_AZERBAIJAN            @map("west_azerbaijan")
  MAZANDARAN                 @map("mazandaran")
  GILAN                      @map("gilan")
  KERMAN                     @map("kerman")
  SISTAN_AND_BALUCHESTAN     @map("sistan_and_baluchestan")
  GOLESTAN                   @map("golestan")
  ARDABIL                    @map("ardabil")
  QOM                        @map("qom")
  MARKAZI                    @map("markazi")
  HORMOZGAN                  @map("hormozgan")
  KERMANSHAH                 @map("kermanshah")
  ALBORZ                     @map("alborz")
  LORESTAN                   @map("lorestan")
  HAMADAN                    @map("hamadan")
  YAZD                       @map("yazd")
  KOHGILUYEH_AND_BOYER_AHMAD @map("kohgiluyeh_and_boyer_ahmad")
  CHAHARMAHAL_AND_BAKHTIARI  @map("chaharmahal_and_bakhtiari")
  NORTH_KHORASAN             @map("north_khorasan")
  SOUTH_KHORASAN             @map("south_khorasan")
  ILAM                       @map("ilam")
  BUSHEHR                    @map("bushehr")
  ZANJAN                     @map("zanjan")
  QAZVIN                     @map("qazvin")
  SEMNAN                     @map("semnan")
  KURDISTAN                  @map("kurdistan")
}

enum RankType {
  COLOR @map("color")
  POOM  @map("poom")
  DAN   @map("dan")
}

enum Discipline {
  KYORUGI @map("kyorugi")
  POOMSAE @map("poomsae")
}

enum CompetitionStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  CANCELED  @map("canceled")
}

enum PaymentStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  REJECTED  @map("rejected")
}

enum RegistrationStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum RefundReason {
  REGISTRATION_REJECTED @map("registration_rejected")
  COMPETITION_CANCELED  @map("competition_canceled")
}

enum RefundStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
}

enum CompetitionLevel {
  PROVINCIAL @map("provincial")
  COUNTY     @map("county")
}

enum CountyChangeStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum StudentTransferStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum StudentPhotoChangeStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum StudentProvinceChangeStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum WeighInVerdict {
  MATCH         @map("match")
  MOVED         @map("moved")
  OUT_OF_WEIGHT @map("out_of_weight")
}

enum ProfileStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum StoredFileProvider {
  DB @map("db")
  R2 @map("r2")
}

enum StudentDocumentType {
  PHOTO                            @map("photo")
  NATIONAL_ID_OR_BIRTH_CERTIFICATE @map("national_id_or_birth_certificate")
  INSURANCE                        @map("insurance")
  BELT_CERTIFICATE                 @map("belt_certificate")
}

// ───────────── Users ─────────────

// Counties (شهرستان) live inside a province. Coaches belong to one county of
// their province; admins have none.
model County {
  id       String   @id @default(uuid()) @map("id")
  province Province @map("province")
  name     String   @map("name") @db.VarChar(80)

  coaches            User[]
  competitions       CompetitionCounty[]
  changeRequestsFrom CoachCountyChangeRequest[] @relation("CountyChangeFrom")
  changeRequestsTo   CoachCountyChangeRequest[] @relation("CountyChangeTo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([province, name])
  @@map("counties")
}

// Accounts are created by an admin. Coaches belong to a province and a county.
model User {
  id           String      @id @default(uuid()) @map("id")
  mobile       String      @unique @map("mobile") @db.VarChar(11)
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name") @db.VarChar(80)
  nationalCode String?     @unique @map("national_code") @db.VarChar(10)
  role         Role        @map("role")
  gender       Gender?     @map("gender") // required for COACH (set at creation, CHECK users_coach_gender_required); students inherit it
  province     Province?   @map("province") // required for ADMIN and COACH (CHECK users_coach_province_required), null for SUPER_ADMIN (enforced in services)
  isActive     Boolean     @default(true) @map("is_active")
  countyId     String?     @map("county_id") // required for COACH (CHECK users_coach_county_required), null for admins and super admin
  county       County?     @relation(fields: [countyId], references: [id])
  photoFileId  String?     @unique @map("photo_file_id")
  photoFile    StoredFile? @relation("CoachPhotoFile", fields: [photoFileId], references: [id])

  students               Student[]
  registrations          Registration[]
  payments               Payment[]
  deadlineExtensions     DeadlineExtension[]            @relation("DeadlineExtensionCreatedBy")
  refunds                Refund[]                       @relation("RefundCoach")
  processedRefunds       Refund[]                       @relation("RefundProcessedBy")
  reviewedProfiles       Student[]                      @relation("StudentProfileReviewedBy")
  countyChangeRequests   CoachCountyChangeRequest[]     @relation("CountyChangeCoach")
  decidedCountyChanges   CoachCountyChangeRequest[]     @relation("CountyChangeDecidedBy")
  transfersFrom          StudentTransfer[]              @relation("TransferFromCoach")
  transfersTo            StudentTransfer[]              @relation("TransferToCoach")
  decidedTransfers       StudentTransfer[]              @relation("TransferDecidedBy")
  provinceChangesTo      StudentProvinceChangeRequest[] @relation("ProvinceChangeToCoach")
  provinceChangesFrom    StudentProvinceChangeRequest[] @relation("ProvinceChangeFromCoach")
  decidedProvinceChanges StudentProvinceChangeRequest[] @relation("ProvinceChangeDecidedBy")
  decidedPhotoChanges    StudentPhotoChangeRequest[]    @relation("PhotoChangeDecidedBy")
  auditLogs              AuditLog[]                     @relation("AuditLogActor")
  checkedInRegistrations Registration[]                 @relation("RegistrationCheckInBy")
  weighedRegistrations   Registration[]                 @relation("RegistrationWeighInBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Student {
  id           String   @id @default(uuid()) @map("id")
  fullName     String   @map("full_name") @db.VarChar(80)
  gender       Gender   @map("gender")
  nationalCode String   @unique @map("national_code") @db.VarChar(10)
  birthDate    DateTime @map("birth_date") @db.Date

  insuranceDate     DateTime? @map("insurance_date") @db.Date
  tkdBankChargeDate DateTime? @map("tkd_bank_charge_date") @db.Date

  // Contact and rank metadata captured by the coach at registration; both are
  // optional so pre-existing rows stay valid.
  mobile              String?   @map("mobile") @db.VarChar(11)
  beltCertificateDate DateTime? @map("belt_certificate_date") @db.Date

  beltId  String @map("belt_id")
  belt    Belt   @relation(fields: [beltId], references: [id])
  coachId String @map("coach_id")
  coach   User   @relation(fields: [coachId], references: [id])

  profileStatus ProfileStatus @default(PENDING) @map("profile_status")
  profileNote   String?       @map("profile_note") @db.VarChar(500) // admin note on profile rejection
  approvedById  String?       @map("approved_by_id")
  approvedBy    User?         @relation("StudentProfileReviewedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?     @map("approved_at")

  documents StudentDocument[]

  registrations          Registration[]
  transfers              StudentTransfer[]              @relation("StudentTransferStudent")
  photoChangeRequests    StudentPhotoChangeRequest[]    @relation("StudentPhotoChangeStudent")
  provinceChangeRequests StudentProvinceChangeRequest[] @relation("StudentProvinceChangeStudent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([coachId])
  @@map("students")
}

// ───────────── Base data (same as the existing schema) ─────────────

// Belts are editable base data: code is the stable identifier, label is the
// Persian name shown in the UI. Archived belts stay visible to old data.
model Belt {
  id       String   @id @default(uuid()) @map("id")
  code     String   @unique @map("code") @db.VarChar(60)
  label    String   @unique @map("label") @db.VarChar(60)
  level    Int      @map("level")
  order    Int?     @map("order")
  rankType RankType @default(COLOR) @map("rank_type")
  color    String?  @map("color")
  colorHex String?  @map("color_hex")
  isActive Boolean  @default(true) @map("is_active")

  students Student[]
  minFor   Competition[] @relation("CompetitionMinBelt")
  maxFor   Competition[] @relation("CompetitionMaxBelt")

  @@map("belts")
}

// Age categories follow the same code/label/isActive pattern as belts; the
// birth years are Jalali and derived from the date range on every write.
model AgeCategory {
  id             String   @id @default(uuid())
  code           String   @unique @map("code") @db.VarChar(60)
  label          String   @unique @map("label") @db.VarChar(60)
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  birthYearStart Int?     @map("birth_year_start")
  birthYearEnd   Int?     @map("birth_year_end")
  isActive       Boolean  @default(true) @map("is_active")

  weightClasses WeightClass[]
  competitions  Competition[]

  @@map("age_categories")
}

model WeightClass {
  id            String      @id @default(uuid()) @map("id")
  ageCategoryId String      @map("age_category_id")
  ageCategory   AgeCategory @relation(fields: [ageCategoryId], references: [id], onDelete: Cascade)
  gender        Gender      @map("gender")
  label         String      @map("label")
  minWeightKg   Decimal     @map("min_weight_kg") @db.Decimal(5, 3)
  maxWeightKg   Decimal?    @map("max_weight_kg") @db.Decimal(5, 3)
  order         Int         @map("order")
  excludeMin    Boolean     @default(false) @map("exclude_min")
  excludeMax    Boolean     @default(true) @map("exclude_max")
  isActive      Boolean     @default(true) @map("is_active")

  registrations Registration[]

  @@index([ageCategoryId, gender, order], map: "weight_class_category_gender_order")
  @@map("weight_classes")
}

// ───────────── Competitions ─────────────

model Competition {
  id          String   @id @default(uuid()) @map("id")
  title       String   @map("title") @db.VarChar(150)
  description String?  @map("description") @db.VarChar(2000) // optional note for coaches, written by the province admin
  province    Province @map("province")

  level    CompetitionLevel    @default(PROVINCIAL) @map("level")
  counties CompetitionCounty[] // one or more counties when level is COUNTY, none when PROVINCIAL

  discipline    Discipline  @map("discipline")
  gender        Gender      @map("gender")
  ageCategoryId String      @map("age_category_id")
  ageCategory   AgeCategory @relation(fields: [ageCategoryId], references: [id])
  minBeltId     String      @map("min_belt_id")
  minBelt       Belt        @relation("CompetitionMinBelt", fields: [minBeltId], references: [id])
  maxBeltId     String      @map("max_belt_id")
  maxBelt       Belt        @relation("CompetitionMaxBelt", fields: [maxBeltId], references: [id])

  feePerStudent        BigInt            @map("fee_per_student") // rials
  payeeCardNumber      String            @map("payee_card_number") @db.VarChar(16)
  payeeCardHolder      String            @map("payee_card_holder") @db.VarChar(80)
  registrationDeadline DateTime          @map("registration_deadline")
  eventDate            DateTime          @map("event_date")
  status               CompetitionStatus @default(DRAFT) @map("status")
  cancelReason         String?           @map("cancel_reason") @db.VarChar(500) // admin note on cancel
  rulesSnapshot        Json?             @map("rules_snapshot") // frozen rules taken when the competition is published

  registrations      Registration[]
  deadlineExtensions DeadlineExtension[]
  payments           Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([province, status])
  @@map("competitions")
}

// A county level competition is held in one or more counties of its province;
// a provincial competition has none. The list is locked once registrations exist.
model CompetitionCounty {
  id            String      @id @default(uuid()) @map("id")
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  countyId      String      @map("county_id")
  county        County      @relation(fields: [countyId], references: [id], onDelete: Cascade)

  @@unique([competitionId, countyId])
  @@index([countyId])
  @@map("competition_counties")
}

// A coach asks to move to another county of the same province. The admin
// approves or rejects it; approval changes only the coach county.
model CoachCountyChangeRequest {
  id           String             @id @default(uuid()) @map("id")
  coachId      String             @map("coach_id")
  coach        User               @relation("CountyChangeCoach", fields: [coachId], references: [id])
  fromCountyId String             @map("from_county_id")
  fromCounty   County             @relation("CountyChangeFrom", fields: [fromCountyId], references: [id])
  toCountyId   String             @map("to_county_id")
  toCounty     County             @relation("CountyChangeTo", fields: [toCountyId], references: [id])
  status       CountyChangeStatus @default(PENDING) @map("status")
  note         String?            @map("note") @db.VarChar(500) // admin note on rejection
  decidedById  String?            @map("decided_by_id")
  decidedBy    User?              @relation("CountyChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?          @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([coachId])
  @@index([status, createdAt])
  @@map("coach_county_change_requests")
}

// A coach asks to receive a student from their current coach. The admin of the
// province decides; approval changes only student.coachId. Rows are history:
// they are never deleted or rewritten, only moved from PENDING once.
model StudentTransfer {
  id          String                @id @default(uuid()) @map("id")
  studentId   String                @map("student_id")
  student     Student               @relation("StudentTransferStudent", fields: [studentId], references: [id])
  fromCoachId String                @map("from_coach_id")
  fromCoach   User                  @relation("TransferFromCoach", fields: [fromCoachId], references: [id])
  toCoachId   String                @map("to_coach_id")
  toCoach     User                  @relation("TransferToCoach", fields: [toCoachId], references: [id])
  status      StudentTransferStatus @default(PENDING) @map("status")
  note        String?               @map("note") @db.VarChar(500) // admin note on rejection
  decidedById String?               @map("decided_by_id")
  decidedBy   User?                 @relation("TransferDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?             @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([status, createdAt])
  @@index([fromCoachId])
  @@index([toCoachId])
  @@map("student_transfers")
}

// A coach asks to replace the profile photo of their own student. The photo
// lives behind the request until the province admin approves it; only then it
// becomes the student PHOTO document. Rows are history, like transfers.
model StudentPhotoChangeRequest {
  id          String                   @id @default(uuid()) @map("id")
  studentId   String                   @map("student_id")
  student     Student                  @relation("StudentPhotoChangeStudent", fields: [studentId], references: [id])
  newFileId   String                   @unique @map("new_file_id")
  newFile     StoredFile               @relation("StudentPhotoChangeFile", fields: [newFileId], references: [id])
  status      StudentPhotoChangeStatus @default(PENDING) @map("status")
  note        String?                  @map("note") @db.VarChar(500) // admin note on rejection
  decidedById String?                  @map("decided_by_id")
  decidedBy   User?                    @relation("PhotoChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?                @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([status, createdAt])
  @@map("student_photo_change_requests")
}

// A coach asks to move their own student to a coach of another province. The
// admin of the destination province decides; approval moves the student to
// the target coach. Provinces are snapshots taken when the request is made.
model StudentProvinceChangeRequest {
  id           String                      @id @default(uuid()) @map("id")
  studentId    String                      @map("student_id")
  student      Student                     @relation("StudentProvinceChangeStudent", fields: [studentId], references: [id])
  fromCoachId  String                      @map("from_coach_id")
  fromCoach    User                        @relation("ProvinceChangeFromCoach", fields: [fromCoachId], references: [id])
  fromProvince Province                    @map("from_province")
  toProvince   Province                    @map("to_province")
  toCoachId    String                      @map("to_coach_id")
  toCoach      User                        @relation("ProvinceChangeToCoach", fields: [toCoachId], references: [id])
  status       StudentProvinceChangeStatus @default(PENDING) @map("status")
  note         String?                     @map("note") @db.VarChar(500) // admin note on rejection
  decidedById  String?                     @map("decided_by_id")
  decidedBy    User?                       @relation("ProvinceChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?                   @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([status, createdAt])
  @@index([toProvince, status])
  @@map("student_province_change_requests")
}

// Who changed what across provinces: admins, counties and age category dates.
// details holds no personal data (no names, mobiles, national codes).
model AuditLog {
  id         String  @id @default(uuid()) @map("id")
  actorId    String  @map("actor_id")
  actor      User    @relation("AuditLogActor", fields: [actorId], references: [id])
  action     String  @map("action") @db.VarChar(60)
  entityType String  @map("entity_type") @db.VarChar(60)
  entityId   String? @map("entity_id")
  details    Json?   @map("details")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Each row is the only allowed change to a competition deadline once
// registrations exist: it keeps the previous deadline and who extended it.
model DeadlineExtension {
  id                String      @id @default(uuid()) @map("id")
  competitionId     String      @map("competition_id")
  competition       Competition @relation(fields: [competitionId], references: [id])
  previousDeadline  DateTime    @map("previous_deadline")
  newDeadline       DateTime    @map("new_deadline")
  reopenForRejected Boolean     @default(false) @map("reopen_for_rejected")
  reason            String      @map("reason") @db.VarChar(500)
  createdById       String      @map("created_by_id")
  createdBy         User        @relation("DeadlineExtensionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([competitionId])
  @@map("deadline_extensions")
}

// ───────────── Registration and payment ─────────────

// Private uploaded files (payment receipts and profile photos). New objects
// live in a private Cloudflare R2 bucket (objectKey) and old rows keep their
// bytes in PostgreSQL; both are served through authenticated endpoints only.
model StoredFile {
  id        String             @id @default(uuid()) @map("id")
  mime      String             @map("mime") @db.VarChar(100)
  size      Int                @map("size")
  provider  StoredFileProvider @default(DB) @map("provider")
  objectKey String?            @unique @map("object_key")
  data      Bytes?             @map("data")
  createdAt DateTime           @default(now()) @map("created_at")

  coachPhoto         User?                      @relation("CoachPhotoFile")
  studentDocuments   StudentDocument[]
  photoChangeRequest StudentPhotoChangeRequest? @relation("StudentPhotoChangeFile")

  @@map("stored_files")
}

// Private profile documents of a student; one document per type, replaced by upload.
model StudentDocument {
  id        String              @id @default(uuid()) @map("id")
  studentId String              @map("student_id")
  student   Student             @relation(fields: [studentId], references: [id])
  type      StudentDocumentType @map("type")
  fileId    String              @map("file_id")
  file      StoredFile          @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, type])
  @@index([studentId])
  @@map("student_documents")
}

// One payment (one receipt) can cover several students.
// Later, a payment gateway can create Payment rows the same way.
model Payment {
  id            String      @id @default(uuid()) @map("id")
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])
  coachId       String      @map("coach_id")
  coach         User        @relation(fields: [coachId], references: [id])

  amount     BigInt        @map("amount")
  receiptKey String?       @map("receipt_key") // uploaded card-to-card receipt
  status     PaymentStatus @default(PENDING) @map("status")
  note       String?       @map("note") @db.VarChar(500) // admin note on rejection

  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([competitionId, status])
  @@map("payments")
}

// One row per failed login attempt, keyed by mobile and by hashed IP.
// Old rows are pruned on every failure; the table stays tiny.
model LoginFailure {
  id        String   @id @default(uuid()) @map("id")
  key       String   @map("key") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("login_failures")
}

model Registration {
  id            String      @id @default(uuid()) @map("id")
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])
  studentId     String      @map("student_id")
  student       Student     @relation(fields: [studentId], references: [id])
  coachId       String      @map("coach_id")
  coach         User        @relation(fields: [coachId], references: [id])
  paymentId     String?     @map("payment_id")
  payment       Payment?    @relation(fields: [paymentId], references: [id])

  // Kyorugi only: resolved from the competition rules snapshot at registration
  weightClassId    String?      @map("weight_class_id")
  weightClass      WeightClass? @relation(fields: [weightClassId], references: [id])
  weightClassLabel String?      @map("weight_class_label") @db.VarChar(60)
  weightClassMin   Decimal?     @map("weight_class_min") @db.Decimal(5, 3)
  weightClassMax   Decimal?     @map("weight_class_max") @db.Decimal(5, 3)

  status RegistrationStatus @default(PENDING) @map("status")
  note   String?            @map("note") @db.VarChar(500) // admin note on rejection

  // Event day: attendance and the official weigh-in, recorded by the province
  // admin on APPROVED registrations of a PUBLISHED competition. The verdict is
  // resolved from the competition rules snapshot; MOVED also updates the
  // weight class snapshot columns above.
  checkInAt      DateTime?       @map("check_in_at")
  checkInById    String?         @map("check_in_by_id")
  checkInBy      User?           @relation("RegistrationCheckInBy", fields: [checkInById], references: [id])
  weighInKg      Decimal?        @map("weigh_in_kg") @db.Decimal(5, 2)
  weighInAt      DateTime?       @map("weigh_in_at")
  weighInById    String?         @map("weigh_in_by_id")
  weighInBy      User?           @relation("RegistrationWeighInBy", fields: [weighInById], references: [id])
  weighInVerdict WeighInVerdict? @map("weigh_in_verdict")

  refund Refund?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Uniqueness of one active registration per (competition, student) is a
  // partial unique index committed in a raw SQL migration, so REJECTED rows
  // stay as history and a new registration can be created.
  @@index([competitionId, status])
  @@index([coachId])
  @@map("registrations")
}

// Manual refunds recorded by an admin: one row per registration, created when
// a confirmed-payment registration is rejected or the competition is canceled.
// The money always goes back to the paying coach, never the student.
model Refund {
  id             String       @id @default(uuid()) @map("id")
  registrationId String       @unique @map("registration_id")
  registration   Registration @relation(fields: [registrationId], references: [id])
  coachId        String       @map("coach_id")
  coach          User         @relation("RefundCoach", fields: [coachId], references: [id])
  amount         BigInt       @map("amount") // rials, equals the competition fee per student
  reason         RefundReason @map("reason")
  status         RefundStatus @default(PENDING) @map("status")
  processedById  String?      @map("processed_by_id")
  processedBy    User?        @relation("RefundProcessedBy", fields: [processedById], references: [id])
  processedAt    DateTime?    @map("processed_at")
  note           String?      @map("note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([coachId])
  @@map("refunds")
}
