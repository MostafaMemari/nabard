DATABASE_URL=
# optional: used by the Prisma CLI (migrate) only if set; falls back to DATABASE_URL
# DIRECT_URL=
# optional: signs the session cookie; derived from DATABASE_URL when unset
# SESSION_SECRET=
ADMIN_MOBILE=
ADMIN_PASSWORD=
ADMIN_PROVINCE=
NEXT_PUBLIC_API_URL=
# optional: Cloudflare R2 private bucket for stored files; when all four are set
# uploads go to R2, otherwise they stay in PostgreSQL (local development)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# optional and unused by the app (the bucket stays private, files are served
# only through authenticated endpoints)
# R2_PUBLIC_URL=
