DATABASE_URL=
# optional: used by the Prisma CLI (migrate) only if set; falls back to DATABASE_URL
# DIRECT_URL=
# optional: signs the session cookie; derived from DATABASE_URL when unset
# SESSION_SECRET=
ADMIN_MOBILE=
ADMIN_PASSWORD=
ADMIN_PROVINCE=
NEXT_PUBLIC_API_URL=
# optional: Cloudflare R2 bucket for stored files; when all four are set
# uploads go to R2, otherwise they stay in PostgreSQL (local development)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# optional: public base url of the main bucket (r2.dev subdomain or custom
# domain); when set, photo urls point straight at R2 with no signature
# R2_PUBLIC_URL=
# optional: separate private bucket for payment receipts (no public endpoint);
# receipts are served only through the authenticated payments file route.
# When unset, receipts fall back to R2_BUCKET_NAME.
# R2_RECEIPTS_BUCKET=
