{
  "name": "nabard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma migrate resolve --rolled-back 20261103090000_coach_gender_backfill || true) && (prisma migrate resolve --rolled-back 20261103093000_demo_competition_titles || true) && prisma migrate deploy && tsx prisma/storage-recompress-photos.ts -- --yes && tsx prisma/ensure-super-admin.ts && next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "db:make-super-admin": "tsx prisma/make-super-admin.ts",
    "db:clean-demo": "tsx prisma/clean-demo.ts",
    "storage:migrate-to-r2": "tsx prisma/storage-migrate-to-r2.ts",
    "storage:verify-r2": "tsx prisma/storage-r2-verify.ts",
    "storage:recompress-photos": "tsx prisma/storage-recompress-photos.ts",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns-jalali": "4.4.0-0",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.3.4"
}
